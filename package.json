{
  "name": "rhythm-map-search",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "dev:electron": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3001 && npm:electron\"",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "dist": "next build && node scripts/prepare-standalone.mjs && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "electron": "^38",
    "electron-builder": "^26",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8"
  },
  "build": {
    "appId": "com.rhythmmapsearch.app",
    "productName": "Rhythm Map Search",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone-app",
        "to": "standalone"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
